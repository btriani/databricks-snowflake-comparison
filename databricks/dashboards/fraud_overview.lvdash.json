{
  "datasets": [
    {
      "name": "kpi_today",
      "displayName": "Today's KPIs",
      "queryLines": [
        "SELECT trans_date, total_txn, total_amt_processed, fraud_txn, fraud_amt_processed, fraud_rate FROM northwind_payments.gold.kpi_executive ORDER BY trans_date DESC LIMIT 1"
      ]
    },
    {
      "name": "fraud_rate_timeseries",
      "displayName": "Daily Fraud Rate",
      "queryLines": [
        "SELECT trans_date, fraud_rate FROM northwind_payments.gold.kpi_executive ORDER BY trans_date"
      ]
    },
    {
      "name": "fraud_by_category_state",
      "displayName": "Fraud Rate by Category x State",
      "queryLines": [
        "SELECT merchant_category, customer_state, AVG(fraud_rate) AS fraud_rate, SUM(txn_count) AS txn_count FROM northwind_payments.gold.fct_fraud_daily GROUP BY merchant_category, customer_state HAVING SUM(txn_count) >= 10 ORDER BY fraud_rate DESC"
      ]
    },
    {
      "name": "top_risk_merchants",
      "displayName": "Top Merchants by Fraud Exposure",
      "queryLines": [
        "SELECT merchant_name, category, total_amt, fraud_amt, fraud_rate FROM northwind_payments.gold.fct_merchant_exposure ORDER BY fraud_amt DESC LIMIT 10"
      ]
    }
  ],
  "pages": [
    {
      "name": "main",
      "displayName": "NorthWind Fraud Overview",
      "layout": [
        {
          "widget": {
            "name": "kpi_counter",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "kpi_today",
                  "fields": [
                    {"name": "fraud_rate", "expression": "`fraud_rate`"}
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "fraud_rate",
                  "displayName": "fraud_rate",
                  "format": {"type": "number-percent", "decimalPlaces": {"type": "exact", "places": 2}},
                  "rowNumber": 1,
                  "style": {"rules": []}
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Today's Fraud Rate",
                "showDescription": false
              }
            }
          },
          "position": {"x": 0, "y": 0, "width": 2, "height": 4}
        },
        {
          "widget": {
            "name": "kpi_volume",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "kpi_today",
                  "fields": [
                    {"name": "total_amt_processed", "expression": "`total_amt_processed`"}
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 2,
              "widgetType": "counter",
              "encodings": {
                "value": {
                  "fieldName": "total_amt_processed",
                  "displayName": "total_amt_processed",
                  "format": {"type": "number-currency", "currencyCode": "USD", "abbreviation": "compact", "decimalPlaces": {"type": "exact", "places": 1}},
                  "rowNumber": 1,
                  "style": {"rules": []}
                }
              },
              "frame": {
                "showTitle": true,
                "title": "Today's Volume Processed",
                "showDescription": false
              }
            }
          },
          "position": {"x": 2, "y": 0, "width": 2, "height": 4}
        },
        {
          "widget": {
            "name": "fraud_rate_line",
            "queries": [
              {
                "name": "main_query",
                "query": {
                  "datasetName": "fraud_rate_timeseries",
                  "fields": [
                    {"name": "trans_date", "expression": "`trans_date`"},
                    {"name": "fraud_rate", "expression": "`fraud_rate`"}
                  ],
                  "disaggregated": true
                }
              }
            ],
            "spec": {
              "version": 3,
              "widgetType": "line",
              "encodings": {
                "x": {
                  "fieldName": "trans_date",
                  "displayName": "Date",
                  "scale": {"type": "temporal"},
                  "axis": {"title": "Date"}
                },
                "y": {
                  "fieldName": "fraud_rate",
                  "displayName": "Fraud Rate",
                  "scale": {"type": "quantitative"},
                  "axis": {"title": "Fraud Rate"}
                },
                "label": {"show": false}
              },
              "frame": {
                "showTitle": true,
                "title": "Daily Fraud Rate Trend",
                "showDescription": false
              },
              "mark": {
                "colors": ["#FF3621", "#077A9D", "#FFAB00", "#00A972"]
              }
            }
          },
          "position": {"x": 4, "y": 0, "width": 2, "height": 4}
        },
