                  {"fieldName": "txn_count", "title": "Transactions", "type": "integer", "displayAs": "number", "displayName": "txn_count", "numberFormat": "0,0", "order": 3, "visible": true, "alignContent": "right", "allowHTML": false, "allowSearch": false, "booleanValues": ["false","true"], "highlightLinks": false, "imageHeight": "", "imageTitleTemplate": "{{ @ }}", "imageUrlTemplate": "{{ @ }}", "imageWidth": "", "linkOpenInNewTab": true, "linkTextTemplate": "{{ @ }}", "linkTitleTemplate": "{{ @ }}", "linkUrlTemplate": "{{ @ }}", "preserveWhitespace": false, "useMonospaceFont": false}
