# ─── Databricks (used in M2) ───
# Workspace URL (Settings → Workspace URL, looks like https://dbc-XXXX.cloud.databricks.com)
DATABRICKS_HOST=

# Personal Access Token (User Settings → Developer → Access Tokens → Generate)
# Lifetime ≥ 30 days recommended for the duration of this project
DATABRICKS_TOKEN=

# Optional: profile name to use in ~/.databrickscfg (default: DEFAULT)
DATABRICKS_PROFILE=DEFAULT

# Snowflake (used in M3)
# SNOWFLAKE_ACCOUNT=xy12345.us-east-1
# SNOWFLAKE_USER=...
# SNOWFLAKE_PASSWORD=...
# SNOWFLAKE_ROLE=ACCOUNTADMIN
# SNOWFLAKE_WAREHOUSE=NORTHWIND_WH
